#!/usr/bin/env bash
set -euo pipefail

if ! command -v jj >/dev/null; then
  jj_version="0.44.0"
  jj_archive="jj-v${jj_version}-x86_64-unknown-linux-musl.tar.gz"
  jj_download_dir=$(mktemp -d)
  trap 'rm -rf "$jj_download_dir"' EXIT

  curl --fail --location --silent --show-error \
    "https://github.com/jj-vcs/jj/releases/download/v${jj_version}/${jj_archive}" \
    --output "$jj_download_dir/$jj_archive"
  tar --extract --gzip --file "$jj_download_dir/$jj_archive" --directory "$jj_download_dir"
  install -Dm755 "$jj_download_dir/jj" "$HOME/.local/bin/jj"
fi

git config --global user.name "Darwin D Wu"
git config --global user.email "darwin67@users.noreply.github.com"
jj config set --user user.name "Darwin D Wu"
jj config set --user user.email "darwin67@users.noreply.github.com"
